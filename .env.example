# MH02 configuration template. Copy to .env.local and fill in. NEVER commit real values.
# Server-side only: no NEXT_PUBLIC_ prefix, so nothing here is sent to the browser.
# For the local database, database/setup/Initialize-AppLogin.ps1 creates .env.local for you.

# --- SQL Server (login with least privilege; never sa, never a sysadmin) ---
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=db_asset_report
DB_USER=mh02_app
DB_PASSWORD=
DB_ENCRYPT=true
# true only for a local self-signed certificate; false on a server with a trusted certificate.
DB_TRUST_SERVER_CERTIFICATE=true

# --- Photos (design decision P4) ---
# Photo FILES live here (never under public/); SQL Server only stores metadata. Staging, quarantine and the
# .storage-ok marker are created inside it. Use a durable, backed-up volume in production.
PHOTO_STORAGE_ROOT=./.storage/photos
PHOTO_MAX_BYTES=10485760
PHOTO_QUARANTINE_DAYS=90

# --- Environment guard for the dev seed ---
MH02_ENV=development

# --- Backend tuning (implementation defaults, shown here commented out; see docs/BACKEND.md) ---
# SESSION_TTL_HOURS=8
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15
# IDEMPOTENCY_LOCK_TIMEOUT_MS=3000
# IDEMPOTENCY_VERIFY_TIMEOUT_MS=5000
# CLOCK_SKEW_SECONDS=120
# TRUST_PROXY=false
# SESSION_COOKIE_SECURE=true   # defaults to true when NODE_ENV=production
# Photo staging, reconciler and integrity check (design 3.12), implementation defaults:
# PHOTO_STAGING_GRACE_MINUTES=60
# PHOTO_LOCK_TIMEOUT_MS=3000
# PHOTO_RECONCILE_INTERVAL_MINUTES=10
# PHOTO_INTEGRITY_INTERVAL_MINUTES=60
# PHOTO_INTEGRITY_BATCH_SIZE=200
# PHOTO_INTEGRITY_VERIFY_HASH=false
# PHOTO_BACKGROUND_JOBS=true      # false disables the reconciler/integrity timers
